# Copy to .env.local and fill in. Never commit real values.
# Qloo hackathon API (base URL is fixed to the hackathon host; other hosts return 401)
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# LLM (OpenAI-compatible). Primary: Qwen on DashScope-intl. Fallback: Groq.
LLM_PROVIDER=qwen
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
