# Copy to .env.local and fill in (secret values are left blank on purpose). Never commit real values. `npm run check` and the Playwright suite need none of these.

# ── Qloo ─────────────────────────────────────────────────────
# Get from: the Qloo Agentic Hackathon API key form (https://qloo.devpost.com/), delivered by email.
# The hackathon key only works against the hackathon host; other hosts return 401.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# ── LLM (OpenAI-compatible) ──────────────────────────────────
# Primary: Qwen on DashScope-intl. Fallback for routing, and the second runner in the coaching race: Groq.
LLM_PROVIDER=qwen
# Get from: https://modelstudio.console.alibabacloud.com/ → API keys (international region)
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-flash
# Get from: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ── Persistence (Vercel Blob) ────────────────────────────────
# Get from: Vercel dashboard → Storage → Blob store (private) → .env.local tab (lib/store.ts).
# Unset locally → in-memory store (refused on Vercel).
BLOB_READ_WRITE_TOKEN=

# ── Rate-limit namespaces (lib/ratelimit.ts) ─────────────────
# Generate with: openssl rand -hex 16   (each must be ≥16 characters; unset → that namespace is unreachable)
# Judges open /?judge=<JUDGE_TOKEN> (own quota, never counted against the public cap); bench runs send x-bench-token.
JUDGE_TOKEN=
BENCH_TOKEN=

# ── Optional overrides ───────────────────────────────────────
# Defaults: 20 plans/IP/hour and 600 plans/day public; judge 60/IP/hour, 400/day; bench 400/day.
# RL_PUBLIC_PLANS_PER_IP_HOUR=
# RL_PUBLIC_DAILY_PLANS=
# RL_JUDGE_PLANS_PER_IP_HOUR=
# RL_JUDGE_DAILY_PLANS=
# RL_BENCH_DAILY_PLANS=
