# Copy to .env.local and fill in. Never commit real values.
# Qloo hackathon API (base URL is fixed to the hackathon host; other hosts return 401)
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# LLM (OpenAI-compatible). Primary: Qwen on DashScope-intl. Fallback: Groq.
LLM_PROVIDER=qwen
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Persistence: private Vercel Blob store (lib/store.ts). Unset locally → in-memory store (refused on Vercel).
BLOB_READ_WRITE_TOKEN=

# Rate limiting (lib/ratelimit.ts). Judges open /?judge=<JUDGE_TOKEN> (own quota, never counted against the public cap);
# bench runs send x-bench-token: <BENCH_TOKEN>. Both must be ≥16 characters; unset → those namespaces are unreachable.
JUDGE_TOKEN=
BENCH_TOKEN=
# Optional overrides (defaults: 20 plans/IP/hour and 600 plans/day public; judge 60/IP/hour, 400/day; bench 400/day)
RL_PUBLIC_PLANS_PER_IP_HOUR=
RL_PUBLIC_DAILY_PLANS=
RL_JUDGE_PLANS_PER_IP_HOUR=
RL_JUDGE_DAILY_PLANS=
RL_BENCH_DAILY_PLANS=
