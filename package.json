{
  "name": "rekindle",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "spike:llm": "tsx scripts/llm-spike.ts --n 5 --out spike/llm-spike.json",
    "typecheck": "tsc --noEmit",
    "spike:qloo": "tsx scripts/spike.ts --out spike/qloo-spike.json --capture fixtures/qloo_captured",
    "maya": "tsx scripts/maya.ts --out spike/maya-e2e.json",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.64",
    "@vercel/blob": "^2.8.1",
    "ai": "^7.0.129",
    "next": "15.5.27",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "description": "Behavioral-activation planning agent for clinicians, built on Qloo Taste AI",
  "license": "MIT",
  "overrides": {
    "postcss": "^8.5.29"
  }
}
